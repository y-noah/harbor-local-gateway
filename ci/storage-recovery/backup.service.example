[Unit]
Description=Harbor PostgreSQL encrypted cluster backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/harbor-storage-tools/node/bin/node /opt/harbor-storage-tools/app/storage-backup.mjs backup
TimeoutStartSec=infinity
TimeoutStopSec=infinity
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
# 操作预算由固定备份配置约束；停止时由CLI取消并等待本次子进程与租约收尾。
# 只签数据库密文副本，不隐含材料一致性、实际恢复、offhost或上线许可。
# 管理员安装前核对本地路径、权限、PG18与固定root profile；工具不会安装此unit。
