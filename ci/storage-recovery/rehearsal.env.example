# 只用于隔离演练。真实值放项目固定凭据入口 harbor.env，按需加载到当前进程。
# 不在命令行参数、仓库或发布记录中填写实际用户名/密码/连接地址。
HARBOR_REHEARSAL_DATABASE_URL='postgresql://USER:PASSWORD@LOCAL_TEST_HOST:PORT/ADMIN_DATABASE'
HARBOR_STORAGE_BACKUP_KEY_FILE='/absolute/private/backup.key'
# 本机独立物理PITR测试需要完整PG18工具目录；不指向共享服务器PGDATA。
HARBOR_TEST_PG_BIN_DIR='/private/tools/postgresql/18/bin'
