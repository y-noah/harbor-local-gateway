[Unit]
Description=Harbor periodic encrypted PostgreSQL backups and WAL checkpoints
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
UMask=0077
CPUQuota=100%
Nice=10
IOWeight=10
ExecStart=/opt/harbor-storage-tools/node/bin/node /opt/harbor-storage-tools/app/storage-backup.mjs schedule
Restart=on-failure
RestartSec=30
TimeoutStopSec=infinity
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
# CLI取消当前操作后等待实际子进程退出及租约释放；不对整个进程组提前发送停止信号。

[Install]
WantedBy=multi-user.target
# 管理员显式安装并核验固定root配置后启用；不自动修改现有服务或部署。
