[Unit]
Requires=harbor-entry-runtime.service
After=harbor-entry-runtime.service
Description=Harbor 固定旧源透明桥
After=network.target docker.service
ConditionPathExists=!/var/lib/harbor-entry/active.json

[Service]
Type=simple
User=root
Group=root
RootDirectory=/var/lib/harbor-entry/jails/legacy
RootDirectoryStartOnly=yes
ExecStartPre=+/usr/bin/nsenter --mount=/proc/1/ns/mnt --root=/proc/1/root --wd=/ -- /usr/bin/python3 -I -B /usr/local/lib/harbor/gateway-entry-controller.py slot-start legacy
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/harbor/gateway-legacy-transparent.py
BindReadOnlyPaths=/usr /lib /lib64
BindReadOnlyPaths=/etc/harbor-entry/legacy:/etc
TemporaryFileSystem=/run:mode=0755
BindPaths=/run/harbor-entry:/run/harbor-entry
ProtectSystem=strict
ReadWritePaths=/run/harbor-entry
ProtectHome=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
